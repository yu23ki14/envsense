// envsense クリップ筐体 — pebble バリアントのパラメータ (#2 / プロダクト外観)
//
// 角丸ボックス(params.scad/enclosure.scad)の「内部レイアウト・キャビティ・基板リテンション・
// 開口」はそのまま流用し、外形だけを「川石モチーフ」に置き換え、裏面に一体成形の
// フレックスクリップ（シャツクリップ式）を追加するための差分パラメータ。
//
// 設計値の単一ソースはこのファイル（外形・クリップは「実測部品」ではないため dimensions.md
// には載せない）。電子部品の実測値・座標系・派生 Z レイヤ・キャビティ寸法は params.scad を継承。
//
// 座標系は params.scad と同一:
//   原点 = XIAO メイン基板 USB-C 側短辺の角 / +X=長手(USB端→尾) / +Y=幅 / z=0=メイン基板上面
//   +Z = カメラ/USB/Sense 側（前面・ドーム・レンズ/マイク/タッチ面）
//   -Z = バッテリー側（裏面・フラット＝クリップ座）

include <params.scad>

// =====================================================================
// 1. 石モチーフ外形（スーパー楕円ベースの有機形状）
// =====================================================================
// 画像準拠の外形寸法。平面はスーパー楕円（角丸長方形〜楕円）で、内部キャビティを
// 余裕をもって内包しつつ滑らかな石形状にする。高さは内部から自動フィット。
peb_l = 50;    // 全長（画像: 約 50）
peb_w = 38;    // 全幅（画像: 約 38）
peb_n = 3.0;   // 平面スーパー楕円の角の張り（2=楕円 / 大きいほど角丸長方形＝中身を内包しやすい）
bottom_inset = 3;  // 裏面フラット面を外形より絞る量（底エッジを膨らませ尖らせない / クリップ座は確保）
waist_h      = 6;  // 裏面からウエスト(最大幅)までの高さ。側面の膨らみ位置

// 内部キャビティの実寸（params.scad 由来）から外殻の天面/裏面 Z を導出。
//   天面壁 = タッチ面なので wall_touch、裏面壁 = 一般 wall。
cav_top_z  = (z_bat_bot - clr) + cav_h;   // キャビティ天面（内側）
cav_bot_z  = (z_bat_bot - clr);           // キャビティ裏面（内側）
peb_z_top  = cav_top_z + wall_touch;      // 外殻 天面頂（カメラ側ドーム）
peb_z_bot  = cav_bot_z - wall;            // 外殻 裏面（フラット＝クリップ座）
peb_h      = peb_z_top - peb_z_bot;       // 参考: 全高 ≈25.8。画像目標 20–23 は top_headroom 追加と
                                          //   カメラ持ち上げ（cam_tip_h=13: SD カードと FPC 根本の
                                          //   干渉回避）を優先して超過を許容（2026-06 決定）

// 外形中心 = キャビティ中心（電子部品を内包したまま、余白を有機形状に使う）
peb_cx = cav_cx;
peb_cy = cav_cy;

// クラウン（天面側の「全高フラット域」）。これがキャビティ平面を内包することで
// 天面/上側側壁の壁厚を保証し、外側だけが石状に丸まり落ちる。
crown_margin = 2.5;              // キャビティ外縁からの余白（天面付近の側壁厚の目安）
crown_a      = cav_l / 2 + crown_margin;
crown_b      = cav_w / 2 + crown_margin;
crown_round  = 2.0;             // 天面エッジの丸め半径（minkowski 球）

// スーパー楕円ポリゴンの分割数（プレビューは粗く、書き出しで上げる）
peb_seg = $preview ? 48 : 96;

// --- 静電タッチ電極（銅箔テープ）座 ---
// ESP32-S3 内蔵タッチを使う。天面内側(キャビティ天井)に浅い角丸ポケットを彫り、
// 銅箔テープを貼って位置決め＆壁内面に密着させる（エアギャップ厳禁）。
// 彫り込みぶん局所的に壁が薄くなり感度が上がる。レンズ/マイク/カメラは回避配置。
touch_pad       = true;                   // 電極座を作るか
touch_pad_size  = 12;                     // 銅箔パッド 一辺(mm)。箔はこれより少し小さく切る
touch_pad_r     = 2;                      // 角丸半径
touch_pad_depth = 0.8;                    // 座の彫り込み深さ。壁 1.6→0.8mm（0.4ノズル2層 = FDM実用下限）に薄化。
                                          //   旧 0.3（残り1.3mm）はタッチ無反応の実機報告を受け感度優先で深化（C∝1/d で約1.6倍）
touch_pad_pos   = [cav_cx + 8, cav_y0 + 6.5];
                                          // 位置: 尾側 × −Y 寄せ（レンズ/マイク/カメラ回避）。
                                          //   −Y 寄せは tail_backstop の単リブ化（+Y 壁寄せ）対応:
                                          //   ポケット上縁 y=11.0 とリブ内側端 y=11.5 の間に 0.5 残す。
                                          //   下縁は −Y キャビティ壁から 0.5（旧: 天井中央 peb_cy）

// 配線通し: tail_backstop（天井吊りリブ ×2）の中央開放部（y ≈ 2.3〜15.3）を使う。
//   専用の配線ノッチ（旧 cut_wire_notch / wire_notch_*）は廃止。

// --- USB-C 開口（石は頭壁が厚い 7.5mm のため、プラグが届く「ザグリ＋スロット」で貫通）---
// 受け口(8.3×2.5)より広い金属スロット ＋ オーバーモールド用の外側ザグリ。
// ザグリで実効壁厚を詰め、残りをプラグ金属部(~6.5mm)が橋渡しして受け口へ届く。
// 開口は断面 full radius（角丸）。ザグリ(外側の見える差し込み口)は 1stプロトで大きすぎたため
//   上下左右 1mm ずつ縮小（14×8 → 12×6）。金属スロットはザグリより小さく収める。
usb_plug_w  = 11.5;             // 金属スロット 幅（プラグ金属部~8.4 をクリア。ザグリ幅より小。実機補正 +0.5）
usb_plug_h  = usb_open_h + 1.5; // 金属スロット 高さ（受け口 + 余裕 = 4.0。実機補正 +0.5）
usb_well_w  = 12.5;            // オーバーモールド用ザグリ 幅（14 → 12 → 実機補正で 12.5）
usb_well_h  = 6.5;            // オーバーモールド用ザグリ 高さ（8 → 6 → 実機補正で 6.5）
usb_well_clr= 1.5;            // ザグリ底から受け口前面までの残し（金属部が届く距離を確保）

// =====================================================================
// 2. 裏面クリップ（一体成形フレックスクリップ）
// =====================================================================
// 旧方式「ピボット＋トーションバネ（モノタロウ 33-0444）＋ピン φ2.8 ＋別パーツ腕」は
// 2026-06 に全廃し、シャツクリップ同様の「たわみ一体型」へ置換（調達部品・組立工程ゼロ。
// 旧設計値・バネ選定の経緯は git 履歴参照）。
// FDM の弾性限界（層内 2–3% / 層間はその半分以下。嵌合フィンガーが層界面で
// もげた実機履歴と同じ制約）に合わせた応力設計:
//   - たわむのは長い腕だけ。bottom は合わせ面ベッドで印刷するので腕は水平スラブ
//     ＝曲げ応力が層内方向（強い向き）に乗る。
//   - 根本ブロック（層をまたぐ向き）は太い剛体。曲げモーメントは腕根本と同じでも
//     断面が大きく、層間応力は数 MPa に収まる。
//   - つまみは「本体背面の半円ビード × 腕の平面」。腕と背面の走行隙間
//     （clip_gap=2.0）はサポート材を立てるための空間で、ピンチはビード頂で
//     clip_pinch=0.4 まで詰める。腕全面を 0.4 隙間で背面に沿わせる案は
//     サポートが入らず宙印刷になるため不成立（ビードは背面側＝印刷で
//     上向きに育つ面なのできれいに出る。腕内面のリブ案は印刷で下向き面に
//     なるため背面側ビードへ置換）。
// 材料は PETG 前提（PLA はクリープと脆性で不向き）。
// 設計目安（PETG E≈2GPa）: 根本→ビード L≈27.5 / 腕厚 2.4 で
//   k = E·w·t³/4L³ ≈ 5–6 N/mm → 布 1mm（たわみ 0.6）で ~3.5N のピンチ。
//   開き 3mm（たわみ 2.6）の根本ひずみ ε = 3tδ/2L² ≈ 1.2% — 層内・弾性域。
clip_root_x  = -4;     // 根本ブロック頭(-X)端。裏面フラットプレート（bottom_inset 後）内に
                       //   収める（-5 だと ±Y 角がプレート輪郭を ~0.5 はみ出て庇になる）
clip_root_l  = 7;      // 根本ブロックの X 長さ（曲げモーメントを受ける溶着 footprint）
clip_root_weld = 1.0;  // 背面壁への食い込み（壁 wall=1.6 内に収める。ビードのトリム面にも使う）
clip_root_r  = 2.0;    // 根本ブロック外側(-X/-Z)エッジの丸め
clip_arm_l   = 33;     // 腕の長さ（根本→先端）。先端 x=36 は背面プレート（〜37.5）内
clip_arm_w0  = 20;     // 腕の根本幅(Y)
clip_arm_w1  = 14;     // 腕の先端幅(Y)（テーパー＝曲げ応力の均一化）
clip_arm_t   = 2.4;    // 腕の厚み（たわみ部の設計厚。グリップ力は t³ で効く）
clip_gap     = 2.0;    // 腕と背面の走行隙間 = サポート材の空間（印刷後に除去）
clip_pinch   = 0.4;    // ビード頂と腕の間のつまみ隙間（布はここで挟まれる）
clip_bead_w  = 10;     // ビードの幅(Y)。先端幅 14 より狭く中央（圧力を集中させる）
clip_bead_inset = 5.5; // 先端からビード中心までの距離（フレアの内側に置く）
clip_flare_l = 3.5;    // 先端フレアの長さ（布のスライドイン呼び込み）
clip_flare_drop = 1.5; // フレアの外側(-Z)への逃げ量 → 先端の口開き = clip_gap + これ
clip_fillet_x = 3.0;   // 腕付け根 内隅フィレットの X 脚（応力集中の緩和。布はここで止まる）
clip_fillet_z = 1.5;   // 同 Z 脚（< clip_gap に収め背面とは繋げない）

// 派生
clip_arm_x0 = clip_root_x + clip_root_l;     // 腕の根本 x
clip_tip_x  = clip_arm_x0 + clip_arm_l;      // 腕の先端 x
clip_bead_x = clip_tip_x - clip_bead_inset;  // ビード中心 x
clip_bead_r = clip_gap - clip_pinch;         // ビード半径 = 突出量（走行隙間 − ピンチ隙間）

// --- 合わせ目（pebble 専用配置: 舌=トップ / 溝=ボトム）---
// ボトムは「クリップが上 = 合わせ面が下」でしか印刷できない（一体クリップが裏面から突き出る）。
// 舌をボトムに置くと合わせ面リムが舌上 2mm に浮く下向き庇になり荒れるため、pebble は
// 舌をトップへ移す: ボトムのリムはベッド一層目で平滑、トップの舌は伏せ印刷の最上部。
// リングは輪郭から lip_off 外へ逃がす: ボトムに掘る溝が隅クランプの側壁溶着(weld)を
// 切断しない条件 lip_off - lip_clr ≥ weld を満たすこと（enclosure_pebble の peb_mating_*）。
lip_off = 1.0;   // 印籠リングの輪郭からの外側オフセット（1.0 - 0.3 = 0.7 ≥ weld 0.6）

// --- 合わせ目のスナップ嵌合（剛体キャッチ舌 × ボトム横梁ラッチ）---
// 履歴（実機報告 3 件を経て本方式へ）:
//   ① 全周リング撓みのビード/ポケット式: 必要ひずみ ε ≈ 1.5·t·δ/L² = 1.5×1.0×0.3/2²
//      ≈ 11% が FDM 弾性限界(2–3%)を大幅超過 → ボトムの薄い係止リッジ(0.8)が塑性変形（2026-06）。
//   ② マグネット吸着(2.3×1.7×1.5 角型 ×3対 接着): 変形部材ゼロだが保持力不足（2026-06）。
//   ③ 独立フィンガー式（舌を 6mm の片持ちへ延長、公称 ε 1.25%）: トップは伏せ印刷なので
//      フィンガーが積層に垂直な片持ちになり、曲げ応力が根本の層界面引張（母材の半分以下）
//      ＋直角根本の応力集中に載って根本からもげた（2026-06）。寸法でなく印刷方向の構造問題。
//   ④ 本方式: 撓む部材をボトムへ移す。トップは剛体の短いキャッチ舌（撓まない→層間は無負荷）、
//      ボトムは溝外壁を局所的に「横向き片持ち梁」へ切り出し、ビードが梁を外へ 0.3 押し退けて
//      梁の下に係止する。ボトムはリム面ベッド印刷なので梁の曲げはペリメータ方向（層内）＝強い。
//      ε ≈ 1.5·latch_t·δ/L² = 1.5×1.2×0.3/7² ≈ 1.3%（層内・弾性域）。
// 開閉: 閉＝ビード下面の丸みが梁上端の呼び込み面取りへ → 梁が外へ撓み → 梁下へカチッ。
//       開＝ビード上面の丸みが梁下端をカムして外へ押し退け（再開可能・無破壊）。
snap_xs   = [cav_cx - cav_l * 0.22, cav_cx + cav_l * 0.22];  // 係止 X 位置（×長辺±Y = 4 箇所）
catch_w   = 6.0;    // キャッチ舌の幅(X)。舌リングと一体（スリット無し＝剛体）
catch_l   = 4.0;    // キャッチ舌の長さ（z=0 → -catch_l）
snap_proj = 0.6;    // ビード半径＝出っ張り量。梁の押し退け量 = snap_proj - lip_clr = 0.3
snap_bead_l   = 4.0;   // ビード長(X)
snap_bead_off = 1.0;   // ビード中心の +X オフセット（梁の自由端寄り＝根本から遠い低ひずみ位置で押す）
snap_bead_z   = (lip_h + 0.2) + snap_proj - 0.15;
                       // ビード中心深さ = 2.65。梁下端(-(lip_h+0.2) = -2.2)の内縁コーナーが
                       //   ビード上面の円弧へ ~0.06 食い込む予圧 → 半身を引き寄せてガタを消す
                       //   （閉状態の交差体は このビード予圧スリバー ×4 だけが正、で検証する。
                       //   -0.05 だとコーナー〜円弧間に 0.03 の隙: 予圧ゼロのガタ公差勝負になる）
catch_xy_clr  = 0.4;   // 深ポケットの X 片側余裕
catch_tip_clr = 0.7;   // 深ポケット底の余裕（深さ = catch_l + 0.7 = 4.7）
// 横梁ラッチ（ボトム溝外壁の局所片持ち。根本=頭(−X)側 / 自由端=尾(+X)側）
latch_x0  = 8.0;    // px → 根本端の距離（−X）。ビード最近接点(px-1)まで 7.0 が撓みの実効長
latch_x1  = 3.5;    // px → 自由端の距離（+X）。自由端の先に幅 1.0 の縦スリット
latch_t   = 1.2;    // 梁厚(Y)
latch_slit= 0.4;    // 梁下の水平スリット（梁下端の切り離し。印刷は 1.8mm の短ブリッジ）
latch_gap = 0.6;    // 梁背後の逃げ幅（押し退け 0.3 + 余裕）
latch_cham= 0.7;    // 梁上端内縁の呼び込み面取り（ビード進入のカム面。印刷は 45° 内向き庇）
