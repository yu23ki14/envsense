// envsense クリップ筐体 — pebble バリアントのパラメータ (#2 / プロダクト外観)
//
// 角丸ボックス(params.scad/enclosure.scad)の「内部レイアウト・キャビティ・基板リテンション・
// 開口」はそのまま流用し、外形だけを「川石モチーフ」に置き換え、裏面に大きめのクリップ
// （ピボット＋トーションバネ式）を追加するための差分パラメータ。
//
// 設計値の単一ソースはこのファイル（外形・クリップは「実測部品」ではないため dimensions.md
// には載せない）。電子部品の実測値・座標系・派生 Z レイヤ・キャビティ寸法は params.scad を継承。
//
// 座標系は params.scad と同一:
//   原点 = XIAO メイン基板 USB-C 側短辺の角 / +X=長手(USB端→尾) / +Y=幅 / z=0=メイン基板上面
//   +Z = カメラ/USB/Sense 側（前面・ドーム・レンズ/マイク/タッチ面）
//   -Z = バッテリー側（裏面・フラット＝クリップ座）

include <params.scad>

// =====================================================================
// 1. 石モチーフ外形（スーパー楕円ベースの有機形状）
// =====================================================================
// 画像準拠の外形寸法。平面はスーパー楕円（角丸長方形〜楕円）で、内部キャビティを
// 余裕をもって内包しつつ滑らかな石形状にする。高さは内部から自動フィット。
peb_l = 50;    // 全長（画像: 約 50）
peb_w = 38;    // 全幅（画像: 約 38）
peb_n = 3.0;   // 平面スーパー楕円の角の張り（2=楕円 / 大きいほど角丸長方形＝中身を内包しやすい）
bottom_inset = 3;  // 裏面フラット面を外形より絞る量（底エッジを膨らませ尖らせない / クリップ座は確保）
waist_h      = 6;  // 裏面からウエスト(最大幅)までの高さ。側面の膨らみ位置

// 内部キャビティの実寸（params.scad 由来）から外殻の天面/裏面 Z を導出。
//   天面壁 = タッチ面なので wall_touch、裏面壁 = 一般 wall。
cav_top_z  = (z_bat_bot - clr) + cav_h;   // キャビティ天面（内側）
cav_bot_z  = (z_bat_bot - clr);           // キャビティ裏面（内側）
peb_z_top  = cav_top_z + wall_touch;      // 外殻 天面頂（カメラ側ドーム）
peb_z_bot  = cav_bot_z - wall;            // 外殻 裏面（フラット＝クリップ座）
peb_h      = peb_z_top - peb_z_bot;       // 参考: 全高（画像 20–23 に整合するか echo で確認）

// 外形中心 = キャビティ中心（電子部品を内包したまま、余白を有機形状に使う）
peb_cx = cav_cx;
peb_cy = cav_cy;

// クラウン（天面側の「全高フラット域」）。これがキャビティ平面を内包することで
// 天面/上側側壁の壁厚を保証し、外側だけが石状に丸まり落ちる。
crown_margin = 2.5;              // キャビティ外縁からの余白（天面付近の側壁厚の目安）
crown_a      = cav_l / 2 + crown_margin;
crown_b      = cav_w / 2 + crown_margin;
crown_round  = 2.0;             // 天面エッジの丸め半径（minkowski 球）

// スーパー楕円ポリゴンの分割数（プレビューは粗く、書き出しで上げる）
peb_seg = $preview ? 48 : 96;

// --- 静電タッチ電極（銅箔テープ）座 ---
// ESP32-S3 内蔵タッチを使う。天面内側(キャビティ天井)に浅い角丸ポケットを彫り、
// 銅箔テープを貼って位置決め＆壁内面に密着させる（エアギャップ厳禁）。
// 彫り込みぶん局所的に壁が薄くなり感度が上がる。レンズ/マイク/カメラは回避配置。
touch_pad       = true;                   // 電極座を作るか
touch_pad_size  = 12;                     // 銅箔パッド 一辺(mm)。箔はこれより少し小さく切る
touch_pad_r     = 2;                      // 角丸半径
touch_pad_depth = 0.3;                    // 座の彫り込み深さ（箔厚ぶん。壁 1.6→約1.3mm に薄化）
touch_pad_pos   = [cav_cx + 8, peb_cy];   // 位置: 尾側のクリア域（レンズ/マイク/カメラ回避）

// 配線通し: tail_backstop（天井吊りリブ ×2）の中央開放部（y ≈ 2.3〜15.3）を使う。
//   専用の配線ノッチ（旧 cut_wire_notch / wire_notch_*）は廃止。

// --- USB-C 開口（石は頭壁が厚い 7.5mm のため、プラグが届く「ザグリ＋スロット」で貫通）---
// 受け口(8.3×2.5)より広い金属スロット ＋ オーバーモールド用の外側ザグリ。
// ザグリで実効壁厚を詰め、残りをプラグ金属部(~6.5mm)が橋渡しして受け口へ届く。
// 開口は断面 full radius（角丸）。ザグリ(外側の見える差し込み口)は 1stプロトで大きすぎたため
//   上下左右 1mm ずつ縮小（14×8 → 12×6）。金属スロットはザグリより小さく収める。
usb_plug_w  = 11.5;             // 金属スロット 幅（プラグ金属部~8.4 をクリア。ザグリ幅より小。実機補正 +0.5）
usb_plug_h  = usb_open_h + 1.5; // 金属スロット 高さ（受け口 + 余裕 = 4.0。実機補正 +0.5）
usb_well_w  = 12.5;            // オーバーモールド用ザグリ 幅（14 → 12 → 実機補正で 12.5）
usb_well_h  = 6.5;            // オーバーモールド用ザグリ 高さ（8 → 6 → 実機補正で 6.5）
usb_well_clr= 1.5;            // ザグリ底から受け口前面までの残し（金属部が届く距離を確保）

// =====================================================================
// 2. 裏面クリップ（ピボット＋トーションバネ）
// =====================================================================
// ヒンジは頭(-X, カメラ/USB)側。腕は裏面(-Z)を覆って尾(+X)へ伸び、先端に掴み返しと
// ランヤードタブ。トーションバネ・ピンは別調達（モックのみ表示）。
clip_hinge_inset = 8;     // 頭端(-X)からヒンジ軸までの距離
clip_gap         = 0.6;   // 閉時の腕と裏面の隙間（標準オフセット）
clip_arm_t       = 3.0;   // 腕パッドの厚み
clip_arm_l       = 30;    // 腕パッドの長さ(X)（裏面の ~70%）
clip_arm_w       = 22;    // 腕パッドの幅(Y)（~60%）
clip_arm_n       = 3.2;   // 腕パッドのスーパー楕円の張り

// --- 選定トーションばね: モノタロウ 33-0444（確定スペック）---
//   ねじりばね / 材質 SUS304WPB / 線径0.6 / 内径4 / 外径5.2 / 自由角135° / 巻数3.125 /
//   アーム長16 / 使用角度57° / 巻方向 右(RH) / RoHS対応 / ばね定数 0.457 N·mm/° /
//   設計トルク ≈ 0.457×57 ≈ 26 N·mm。差し替え用 33-0441（同寸でより硬い）も同マウント可。
clip_spring_wire  = 0.6;                              // 線径
clip_spring_id    = 4.0;                              // コイル内径（ここにピンを通す）
clip_spring_od    = clip_spring_id + 2 * clip_spring_wire;     // コイル外径 = 5.2
clip_spring_turns = 3.125;                            // 総巻数
clip_spring_w     = clip_spring_turns * clip_spring_wire + 0.4; // コイル軸長 ≈ 2.3（+余裕）
clip_spring_ang   = 135;                              // 自由角（プリロード設計の基準）
clip_spring_use   = 57;                               // 使用角度（設計たわみ角）→ 閉時の脚間角 ≈ 135-57 = 78°
clip_spring_leg   = 16;                               // アーム(脚)長（確定。狭所では切詰め）
clip_spring_rh    = true;                             // 巻方向 右（組付け向きの基準）
clip_spring_y     = peb_cy - 3.0;                     // コイルの Y 位置（中央やや -Y。+Y にナックル）

clip_pin_d   = 3.0;       // ヒンジ軸径（FDM試作: 入手容易な φ3.0 丸棒/M3。内径4コイルに対し遊び~0.5mm/側。
                          //   本番でガタを詰めるなら φ3.5 へ。穴はこの径基準で生成）
clip_boss_gap= 12;        // 2ボスの内法間隔（ナックル＋コイルが入る幅）
clip_boss_w  = 6;         // 各ボスの幅(Y)（φ3.7穴＋肉）
clip_boss_l  = 8;         // 各ボスの長さ(X)
clip_boss_over = 1.0;     // ボス頂部を裏面壁へ食い込ませる溶着代
clip_boss_r  = 2.0;       // ボスの全エッジ丸め半径（minkowski 球。意匠: 角柱の角ばり解消）

clip_lip_l   = 4;         // 先端 掴み返しの長さ(X)。裏面へ斜めに立ち上がり先端で掴む
lanyard_tab_l= 6;         // ランヤードタブの張り出し(X)
lanyard_w    = 7;         // ランヤード溝 幅(Y)
lanyard_l    = 2.5;       // ランヤード溝 開口長(X)

// コイルが裏面より下に収まる落とし込み（ピンを下げる量）
clip_pin_drop = clip_spring_od / 2 + 0.8;   // ≈ 3.4

// --- 合わせ目（pebble 専用配置: 舌=トップ / 溝=ボトム）---
// ボトムは「クリップボスが上 = 合わせ面が下」でしか印刷できない（ボスが裏面から突き出る）。
// 舌をボトムに置くと合わせ面リムが舌上 2mm に浮く下向き庇になり荒れるため、pebble は
// 舌をトップへ移す: ボトムのリムはベッド一層目で平滑、トップの舌は伏せ印刷の最上部。
// リングは輪郭から lip_off 外へ逃がす: ボトムに掘る溝が隅クランプの側壁溶着(weld)を
// 切断しない条件 lip_off - lip_clr ≥ weld を満たすこと（enclosure_pebble の peb_mating_*）。
lip_off = 1.0;   // 印籠リングの輪郭からの外側オフセット（1.0 - 0.3 = 0.7 ≥ weld 0.6）

// --- 合わせ目のスナップ嵌合（印籠リップに併設）---
// 石の外壁は厚く撓まないので、薄い舌(lip_t=1.0)側を撓ませて嵌合する。
// 舌（トップ）の外面にビード（半円ビード）を付け、ボトム側の溝外壁にキャッチポケットを掘る。
// 被せると舌が内側へ逃げ、ビードがポケットに落ちて係止（再開可能）。
snap_proj = 0.6;        // ビード半径＝出っ張り量（舌外面から外へ。0.9 は嵌合力過大 → 低くして撓み量を減らす）
snap_len  = 6;          // ビード長さ(X)
snap_z    = lip_h / 2;  // ビード中心 z（リップ高さの中央）
snap_xs   = [cav_cx - cav_l * 0.22, cav_cx + cav_l * 0.22];  // 長辺の係止 X 位置（左右2箇所）

// 派生：実空間でのヒンジ（ピン）位置
clip_pin_x = (peb_cx - peb_l / 2) + clip_hinge_inset;          // ピン軸 X（頭寄り）
clip_pin_y = peb_cy;                                            // ピン軸 Y（幅中央）
clip_pin_z = peb_z_bot - clip_pin_drop;                        // ピン軸 Z（コイルが裏面下に収まる深さ）
